# Plantilla de variables de entorno. Copiar a .env y ajustar.
# NUNCA poner valores reales de secretos aquí. .env está en .gitignore.

# --- Backend (BFF) ---
PORT=3001
NODE_ENV=development

# --- Acceso al prototipo (requisito 5.6: proteger con clave) ---
# Clave que se comparte solo con el panel evaluador.
PROTOTYPE_ACCESS_KEY=cambia-esta-clave

# --- LLM (Ollama local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Sesión ---
# Tiempo de vida de la sesión conversacional en minutos (persistencia en memoria).
SESSION_TTL_MINUTES=15
# OTP simulado: el valor válido está en los datos ficticios (123456). No es un secreto real.
OTP_MAX_ATTEMPTS=3

# --- CORS (origen permitido del frontend; por defecto * en desarrollo) ---
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:3001
