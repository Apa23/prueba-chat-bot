{
  "name": "prueba-chat-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Prototipo de chatbot con IA para generación de certificados (Opción B - prueba técnica). Prototipo de evaluación, no oficial.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend",
    "test": "npm run test --workspace backend",
    "build": "tsc -b && npm run build --workspace frontend",
    "typecheck": "tsc -b"
  },
  "engines": {
    "node": ">=22"
  }
}
