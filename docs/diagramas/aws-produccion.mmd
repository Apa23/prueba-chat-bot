graph TB
    usuario["Afiliado"]
    subgraph edge["Edge / Seguridad perimetral"]
        waf["AWS WAF + CloudFront<br/>(TLS, rate limiting, OWASP rules)"]
        cognito["Amazon Cognito<br/>(autenticación fuerte + MFA/OTP real)"]
    end
    subgraph vpc["VPC (subredes privadas, multi-AZ)"]
        alb["Application Load Balancer"]
        subgraph ecs["ECS Fargate (auto-scaling)"]
            bffc["BFF / Orquestador (contenedor)"]
        end
        bedrock["Amazon Bedrock<br/>(LLM gestionado, residencia AWS)"]
        secrets["Secrets Manager"]
        rds["Datos de afiliados<br/>(sistema origen / API interna)"]
        redis["ElastiCache Redis (sesión con TTL)"]
        s3["S3 (PDFs temporales, cifrado + lifecycle)"]
    end
    subgraph obs["Observabilidad"]
        cw["CloudWatch (logs/métricas) + X-Ray (trazas)"]
    end

    usuario --> waf --> cognito --> alb --> bffc
    bffc --> bedrock
    bffc --> secrets
    bffc --> rds
    bffc --> redis
    bffc --> s3
    bffc -.-> cw

    classDef sec fill:#fee2e2,color:#111,stroke:#f87171;
    classDef comp fill:#374151,color:#fff,stroke:#1f2937;
    classDef data fill:#e5e7eb,color:#111,stroke:#9ca3af;
    classDef obsc fill:#dcfce7,color:#111,stroke:#4ade80;
    class waf,cognito,secrets sec;
    class bffc,alb comp;
    class bedrock,rds,redis,s3 data;
    class cw obsc;